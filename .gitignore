# Variables de entorno
.env
.env.*
!.env.example
server/.env
client/.env

# Dependencias
node_modules/
.pnpm-store/

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / artefactos de compilación
dist/
build/
*.egg-info/

# Prisma
# ⚠️ NO ignorar prisma/migrations/ — se versiona en git (historial real de la BD)

# Archivos temporales
*.tmp
*.swp
.DS_Store

# IDE
.vscode/
.idea/

# Testing / coverage
coverage/
.nyc_output/

# Docker
# (los volúmenes con datos persistentes ya viven fuera del repo; no hay
